# Supabase — Project Settings / Connect
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Older projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase key — never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key

# Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Secret used to protect the scheduled endpoint.
CRON_SECRET=replace-with-a-random-secret

# Optional: Gemini suggestion wording (built-in fallback is used if unset).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
